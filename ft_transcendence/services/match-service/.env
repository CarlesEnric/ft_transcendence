# Variables de entorno para el microservicio match-service

# Puerto en el que correrá el servidor Fastify
PORT=3004

# SSL Configuration - disabled for internal communication
SSL_ENABLED=false

# Clave secreta para firmar/verificar JWT (cambiar en producción por una segura)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Ruta del archivo de base de datos SQLite (se creará si no existe)
DB_FILE=./matches.db