{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "Authentication service - JWT tokens, user login, Google OAuth",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit"
  },
  "author": "cteixido, fcosta-f, iassambe, avolcy, aduenas-",
  "license": "MIT",
  "dependencies": {
    "fastify": "^5.4.0",
    "@fastify/jwt": "^9.1.0",
    "@fastify/oauth2": "^8.1.2",
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^8.2.0",
    "fastify-multer": "^2.0.3",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^17.2.1",
    "bcrypt": "^6.0.0",
    "sqlite3": "^5.1.7",
    "zod": "^4.0.5",
    "speakeasy": "^2.0.0",
    "qrcode": "^1.5.4",
    "node-fetch": "^3.3.2",
    "jwt-decode": "^4.0.0",
    "@fastify/cookie": "^11.0.2"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/node": "^24.0.13",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/qrcode": "^1.5.5",
    "@types/node-fetch": "^2.6.12",
    "@types/speakeasy": "^2.0.10",
    "@types/multer": "^2.0.0",
    "ts-node": "^10.9.2",
    "nodemon": "^3.1.10"
