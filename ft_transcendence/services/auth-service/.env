# Auth Service Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# SSL Configuration - enabled for internal HTTPS communication
SSL_ENABLED=true

# Database Configuration
DB_PATH=/app/database/auth.db

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
SERVICE_JWT=compartido-con-gateway-o-matchmaking

# BCrypt Configuration
BCRYPT_ROUNDS=12

# OAuth2 Configuration (Google)
GOOGLE_CLIENT_ID=500069451700-rg31l2hdmnnqf380qboachs13kv03704.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
# Usar HOST_IP para mantener consistencia en redireccionamiento
GOOGLE_REDIRECT_URI=https://${HOST_IP}:3000/api/auth/google/callback

# Frontend Configuration
FRONTEND_URL=https://${HOST_IP}:3000

# Force HTTPS for external URLs
EXTERNAL_PROTOCOL=https
