# API Gateway Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# SSL Configuration (enabled for HTTPS)
SSL_ENABLED=true
SSL_KEY_PATH=/app/ssl/key.pem
SSL_CERT_PATH=/app/ssl/cert.pem

# Service URLs (internal Docker network with HTTPS)
AUTH_SERVICE_URL=https://auth:3001
USER_SERVICE_URL=https://user:3002
GAME_SERVICE_URL=https://game:3003
MATCH_SERVICE_URL=https://match:3004

# Frontend Configuration
#FRONTEND_URL=https://bcn42.duckdns.org:3000
#FRONTEND_URL=https://bcn-project.duckdns.org:3000
FRONTEND_URL=https://corb-project.duckdns.org:3000
#FRONTEND_URL=https://domain42.duckdns.org:3000
#FRONTEND_URL=https://localhost:3000
#FRONTEND_URL=https://bcn-transcendence.duckdns.org:3000

# Rate Limiting: 500 requests per 10 seconds
RATE_LIMIT_MAX=500
RATE_LIMIT_WINDOW=10000

# CORS Configuration
#CORS_ORIGIN=https://bcn42.duckdns.org:3000
CORS_ORIGIN=https://corb-project.duckdns.org:3000
#CORS_ORIGIN=https://bcn-project.duckdns.org:3000
#CORS_ORIGIN=https://domain42.duckdns.org:3000
#CORS_ORIGIN=https://localhost:3000
#CORS_ORIGIN=https://bcn-transcendence.duckdns.org:3000
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_CREDENTIALS=true

# JWT secret per validar tokens al gateway
JWT_SECRET=0c797e96bc26834228876a0ac924e7f2b932122cb91d8a2bdc4e1a2aa9d16205
SERVICE_JWT=0e7ebc40d65803f9abcc6a8ef3d8980a9846b3cdc6e960a88c360fd94ccdb884

#GOOGLE_REDIRECT_URI=https://bcn42.duckdns.org:3000/api/auth/google/callback
#GOOGLE_REDIRECT_URI=https://bcn-project.duckdns.org:3000/api/auth/google/callback
GOOGLE_REDIRECT_URI=https://corb-project.duckdns.org:3000/api/auth/google/callback
#GOOGLE_REDIRECT_URI=https://domain42.duckdns.org:3000/api/auth/google/callback
#GOOGLE_REDIRECT_URI=https://localhost:3000/api/auth/google/callback
